# checker/.env namunasi. Haqiqiy qiymatlar bilan `.env` yarating.

# Platforma bilan umumiy kalit — platformaning .env dagi CHECKER_TOKEN bilan
# AYNAN bir xil bo'lishi shart. Hosil qilish:
#   python -c "import secrets; print(secrets.token_hex(32))"
CHECKER_TOKEN=

# Javob varag'idagi QR kod imzosi. Ishlab turgan smartbot'nikidan BOSHQA
# qiymat qo'ying. Chop etilgan varaqlar shu kalitga bog'liq — o'zgartirilsa
# eski varaqlar tekshirilmay qoladi.
QR_SECRET=

CHECKER_HOST=127.0.0.1
CHECKER_PORT=8090

# Ixtiyoriy chegaralar
# CHECKER_MAX_PARALLEL=2
# CHECKER_MAX_UPLOAD_MB=80
# CHECKER_MAX_SCAN_PAGES=300

# Rasmdan savol o'qish (POST /ocr) — Tesseract. Linux'da apt bilan o'rnatilsa
# ikkalasi ham kerak emas. Windows'da (lokal):
# TESSERACT_CMD='C:\Program Files\Tesseract-OCR\tesseract.exe'
# TESSDATA_DIR='C:\path\to\tessdata'
# OCR_LANG=uzb+eng
# CHECKER_MAX_OCR_PAGES=20

# Faqat Windows'da lokal: WeasyPrint uchun Pango/Cairo (MSYS2) DLL papkasi.
# Qarang: smartbot/docs/DECISIONS.md #24.
# WEASYPRINT_DLL_DIRECTORIES=C:\msys64\mingw64\bin
