# /opt/smartacademy/.env — production (docs/DEPLOY.md, 7-qadam). chmod 600.
# <...> larni almashtiring. Hech qachon GitHub'ga yuklamang.

DATABASE_URL="postgresql://smartacademy:<platform_parol>@127.0.0.1:5432/smartacademy_platform?schema=public"

# openssl rand -base64 32 — lokaldagidan BOSHQA qiymat
AUTH_SECRET="<yangi_maxfiy_kalit>"
NEXTAUTH_URL="https://<domen>"
AUTH_TRUST_HOST="true"

# smartbot bilan BIR XIL bot: smartbot/.env dagi BOT_TOKEN. Mini App imzosi,
# Telegram tugmasi bilan kirish, xabarlar va kirish kodlari shu token bilan.
TELEGRAM_BOT_TOKEN="<smartbot_tokeni>"
# Build paytida sahifaga yoziladi: o'zgarsa qayta build kerak.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=""
WEBAPP_URL="https://<domen>"

CHECKER_URL="http://127.0.0.1:8090"
# checker/.env dagi CHECKER_TOKEN bilan AYNAN bir xil: openssl rand -hex 32
CHECKER_TOKEN="<checker_tokeni>"

# Xodim rollari smartbot bazasidan FAQAT O'QILADI (deploy/postgres/setup.sql).
SMARTBOT_DATABASE_URL="postgresql://smartbot_reader:<reader_parol>@127.0.0.1:5432/testbot_db"
SMARTBOT_DB_NAME=""
# smartbot/.env dagi SUPERADMIN_IDS bilan bir xil
SMARTBOT_SUPERADMIN_IDS=""

# MAJBURIY "off": botning xabarlarini smartbot qabul qiladi (docs/DECISIONS.md #23).
BOT_POLLING="off"
