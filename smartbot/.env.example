# Bu NAMUNA fayl. Haqiqiy qiymatlar bilan `.env` yarating.
# `.env` hech qachon GitHub'ga yuklanmaydi (.gitignore da to'silgan).

# BotFather bergan token
BOT_TOKEN=

# PostgreSQL ulanish manzili.
# Drayver ALBATTA asyncpg bo'lishi kerak — kod async ishlaydi.
DATABASE_URL=postgresql+asyncpg://testbot:PAROL@localhost:5432/testbot_db

# Superadmin(lar)ning Telegram chat ID si. Vergul bilan ajratiladi.
# Bu ID lar `admins` jadvalida bo'lmasa ham to'liq huquqqa ega bo'ladi.
SUPERADMIN_IDS=

# Ixtiyoriy kanal a'zoligi talabi (bo'sh bo'lsa, kanal tekshiruvi o'chadi).
# REQUIRED_CHANNEL=@your_channel
# REQUIRED_CHANNEL_URL=https://t.me/your_channel

# Ruxsatnoma QR kodlarini imzolash uchun maxfiy kalit (HMAC-SHA256).
# MAJBURIY — bo'lmasa bot ishga tushmaydi. Hosil qilish:
#   python -c "import secrets; print(secrets.token_hex(32))"
QR_SECRET=

# Ixtiyoriy: ruxsatnoma.html va logo_brend.png qayerda joylashganini
# o'zgartirish uchun. Standart holatda utils/assets/ruxsatnoma/ ishlatiladi.
# TICKET_ASSETS_DIR=

# Ixtiyoriy: javob varag'i shabloni (answer_sheet.html), ArUco belgilari va
# logotip papkasi. Standart holatda utils/assets/answer_sheet/ ishlatiladi.
# ANSWER_SHEET_ASSETS_DIR=

# Faqat Windows'da LOKAL ishlab chiqish uchun kerak (production server —
# Linux, bunda hech narsa qilmaydi). WeasyPrint'ga Pango/Cairo DLL
# fayllari qayerdaligini ko'rsatadi — bo'lmasa "cannot load library"
# xatosi bilan yiqiladi. Qarang: docs/DECISIONS.md, MSYS2 o'rnatish
# qadamlari uchun.
# WEASYPRINT_DLL_DIRECTORIES=C:\msys64\mingw64\bin

# Faqat Windows'da LOKAL ishlab chiqish uchun kerak (production serverda
# poppler-utils apt orqali PATH'ga tushadi, standart "pdftoppm" ishlaydi).
# Windows'da poppler alohida yuklab olinadi va odatda PATH'ga
# qo'shilmaydi — o'sha holatda shu yerga pdftoppm.exe ning TO'LIQ yo'lini
# ko'rsating.
# PDFTOPPM_PATH=C:\poppler\Library\bin\pdftoppm.exe

# SmartAcademy platformasi (Mini App) — ommaviy HTTPS manzil. Berilsa, chatda
# "Open App" menyu tugmasi va /start dan keyin kirish tugmasi chiqadi.
# Bo'sh bo'lsa bot avvalgidek ishlaydi. (docs/DECISIONS.md #38)
PLATFORM_URL=

# Platforma bazasi — FAQAT O'QISH (docs/DECISIONS.md #40): javob varag'ini
# platformada tuzilgan testdan sozlash uchun. Bo'sh bo'lsa bu imkoniyat
# ko'rinmaydi. Serverda read-only foydalanuvchi bilan:
# PLATFORM_DATABASE_URL=postgresql://platform_reader:<parol>@127.0.0.1:5432/smartacademy_platform
PLATFORM_DATABASE_URL=
