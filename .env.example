DATABASE_URL="postgresql://user:password@localhost:5432/smartacademy_platform?schema=public"
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Production'da (`npm run start`) SHART: Auth.js 5 Vercel'dan tashqarida so'rov
# host'iga o'zi ishonmaydi va busiz har bir login/sessiya "UntrustedHost"
# xatosi bilan yiqiladi. Dev rejimda kerak emas. Server nginx/Caddy ortida
# bo'lsa, NEXTAUTH_URL ni haqiqiy https manzilga qo'ying.
AUTH_TRUST_HOST="true"

# @BotFather'dan olingan bot tokeni.
# - Admin login OTP (parol + Telegram tasdiqlash kodi) shu orqali yuboriladi.
# - O'quvchi (Student) kirishi uchun Telegram Login Widget ham shu bot
#   tokeniga bog'lanadi (BotFather'da shu bot uchun /setdomain qilinishi kerak
#   — bu localhost'da ishlamaydi, faqat haqiqiy domenda).
TELEGRAM_BOT_TOKEN=""

# Xuddi shu botning @username'i (token emas, oshkora nom) — brauzerga
# yuboriladi, chunki Telegram Login Widget shu orqali qaysi botni
# ko'rsatishni biladi. Faqat /login/student sahifasida ishlatiladi.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=""

# Telegram Mini App: saytning ommaviy HTTPS manzili (masalan
# https://platform.example.com). Bo'lsa, `npm run bot` botga "Testlarim"
# tugmasini qo'shadi va u /tg sahifasini Telegram ichida ochadi. localhost
# bo'lmaydi — Telegram faqat HTTPS qabul qiladi.
# Telegram xabarlaridagi tugmalar ham shu manzilni ochadi (bo'sh bo'lsa — faqat matn).
WEBAPP_URL=""

# Javob varag'i / OMR servisi (checker/). CHECKER_TOKEN checker/.env dagi
# bilan AYNAN bir xil bo'lishi shart.
CHECKER_URL="http://127.0.0.1:8090"
CHECKER_TOKEN=""

# Birinchi SuperAdmin (seed skript uchun)
SEED_SUPERADMIN_NAME="Super Admin"
SEED_SUPERADMIN_EMAIL="admin@example.com"
# Set a unique, strong password before running the seed script.
SEED_SUPERADMIN_PASSWORD=""

# --- Smartbot Mini App (docs/DECISIONS.md #23) -------------------------------
# Platforma smartbot'dan "Open App" bilan ochiladi; xodim rollari bot bazasidan
# FAQAT O'QILADI. Ikkalasidan biri: to'liq manzil (smartbot .env dagi kabi,
# "+asyncpg" bo'lsa ham bo'ladi) yoki shu Postgres serveridagi baza nomi.
# Ikkalasi bo'sh — rollar platformaning Xodimlar sahifasidagi Telegram ID bo'yicha.
SMARTBOT_DATABASE_URL=""
SMARTBOT_DB_NAME=""
# smartbot .env dagi SUPERADMIN_IDS bilan bir xil, vergul bilan.
SMARTBOT_SUPERADMIN_IDS=""
# Botning xabarlarini smartbot (smartbot/) qabul qiladi — platforma ham getUpdates
# qilsa, bot xabarlarni yo'qotadi. Bo'sh: SMARTBOT_* sozlangan bo'lsa `npm run bot`
# faqat yuboradi, sozlanmagan bo'lsa (alohida test bot) tinglaydi ham.
# "off" — hech qachon tinglamaydi (production); "on" — majburan (faqat alohida test botda!).
BOT_POLLING=""
